flowchart TB
  U["Shopper: kiosk, web, mobile"] <--> O
  S["Store staff: manager tablet"] <--> O

  subgraph HUB["Interface layer"]
    O["01 Orchestrator<br/>intent, routing, session state"]
  end

  subgraph FO["Front office"]
    CPA["02 Customer Profile"]
    CAT["03 Catalog"]
    CART["04 Cart"]
    NAV["05 Navigation"]
  end

  subgraph TX["Transaction core"]
    PRI["06 Pricing"]
    INV["07 Inventory"]
    PAY["08 Payment"]
    ORD["09 Order"]
  end

  subgraph LG["Logistics"]
    DEL["10 Delivery"]
    RET["11 Returns"]
  end

  subgraph OPS["Operations and back office"]
    STF["12 Staff and HR"]
    PRO["13 Procurement"]
    FOR["14 Forecasting"]
  end

  subgraph INTEL["Intelligence and infrastructure"]
    ANA["15 Analytics"]
    AUD["16 Audit"]
  end

  O <--> CPA
  O <--> CAT
  O <--> CART
  O <--> NAV
  O <--> PRI
  O <--> INV
  O <--> PAY
  O <--> ORD
  O <--> DEL
  O <--> RET
  O <--> STF
  O <--> PRO
  O <--> FOR
  O -. "trace events" .-> AUD
  O -. "event stream" .-> ANA
